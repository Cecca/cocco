{# The results half of the submission page: the compiler's complaints, then one
   row per test case. Polled while the submission is still being judged, so it
   has to render the "nothing yet" states too.

   Context: `submission` (status and aggregates), `outcomes` - already put
   through `visible_outcomes`, so a redacted field is simply absent here - and
   `is_staff`. #}

{# The judge records a compile failure once per test case, all carrying the same
   compiler output, so the first one is the whole story. Compiler output does
   not depend on any test input, which is why this block is shown whether or not
   the test case is a public sample. #}
{% set compile_failures = outcomes | selectattr("outcome", "equalto", "compile_failure") | list %}
{% if compile_failures %}
<div class="card bg-base-100 border border-error/40 shadow-sm mb-6">
  <div class="card-body p-7">
    <div class="flex items-center gap-2.5">
      <span class="grid h-6 w-6 place-items-center rounded-md bg-error/15 text-error font-bold">!</span>
      <h2 class="font-bold text-lg">It did not compile</h2>
    </div>
    <p class="text-[13px] text-base-content/55 -mt-1">
      Every test was scored zero without being run. This is what the compiler said.
    </p>
    <pre class="mt-3 overflow-x-auto rounded-xl bg-neutral text-neutral-content p-4 text-xs leading-relaxed font-mono whitespace-pre-wrap">{{ compile_failures[0].message }}</pre>
  </div>
</div>
{% endif %}

<div class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="card-body p-7">
    <div class="flex items-center gap-2.5">
      <h2 class="font-bold text-lg">Test cases</h2>
      {% if submission.status != "done" %}
      <span class="badge badge-ghost gap-1.5 font-mono font-semibold">
        <span class="loading loading-spinner loading-xs"></span>{{ submission.status }}
      </span>
      {% endif %}
    </div>
    <p class="text-[13px] text-base-content/55">
      {% if is_staff %}
      Every test case this submission was graded on, with the judge's output.
      {% else %}
      Hidden test cases show their verdict only — the output of a run on one
      would give the test away.
      {% endif %}
    </p>

    <div class="overflow-x-auto mt-3">
      <table class="table">
        <thead>
          <tr class="text-xs uppercase tracking-wider text-base-content/45 font-mono">
            <th class="w-16">Test</th>
            <th class="w-44">Verdict</th>
            <th class="w-24 text-right">Score</th>
            <th class="w-28 text-right">Time</th>
            <th class="w-28 text-right">Memory</th>
          </tr>
        </thead>
        <tbody>
          {% for outcome in outcomes %}
          <tr>
            <td class="font-mono font-semibold text-base-content/50">
              {{ outcome.execution_order + 1 }}
              {% if outcome.is_sample %}
              <span class="badge badge-ghost badge-sm font-mono ml-1">sample</span>
              {% endif %}
              {% if not outcome.is_active %}
              {# Only reachable for a submission graded before the case was
                 retired: the judge does not run retired cases. #}
              <span class="badge badge-ghost badge-sm font-mono ml-1">retired</span>
              {% endif %}
            </td>
            <td>
              {% if outcome.outcome == "success" %}
              <span class="font-mono text-sm font-semibold text-success">✓ success</span>
              {% else %}
              <span class="font-mono text-sm font-semibold text-error">✗ {{ outcome.outcome }}</span>
              {% endif %}
            </td>
            <td class="text-right font-mono text-sm">{{ outcome.score | score }}</td>
            <td class="text-right font-mono text-sm text-base-content/60">{{ outcome.elapsed_s | duration }}</td>
            <td class="text-right font-mono text-sm text-base-content/60">
              {{ (outcome.peak_memory_bytes / 1024 / 1024) | round(1) ~ " MB" if outcome.peak_memory_bytes else "—" }}
            </td>
          </tr>
          {# The judge's message and the program's own output, on a second row so
             they get the full width. Absent when redacted, and there is nothing
             to add for a compile failure - the block above already said it. #}
          {% if outcome.outcome != "compile_failure" %}
          {% for label, body in [("judge", outcome.message), ("stdout", outcome.stdout), ("stderr", outcome.stderr)] %}
          {% if body %}
          <tr>
            <td colspan="5" class="pt-0">
              <div class="flex items-start gap-3">
                <span class="font-mono text-[10px] uppercase tracking-wider text-base-content/40 pt-1 w-14 shrink-0">{{ label }}</span>
                <pre class="flex-1 overflow-x-auto rounded-lg bg-base-200 px-3 py-2 text-xs font-mono whitespace-pre-wrap">{{ body }}</pre>
              </div>
            </td>
          </tr>
          {% endif %}
          {% endfor %}
          {% endif %}
          {% else %}
          <tr>
            <td colspan="5" class="text-center text-sm text-base-content/45 py-6">
              {% if submission.status == "done" %}
              This submission was not graded on any test case.
              {% else %}
              Waiting for the judge — results appear here as each test is run.
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
