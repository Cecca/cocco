{# Rows for #submission-history. Polled every 2s, so it has to render
   submissions that are still queued or running and have no outcomes yet. #}
{% for submission in submissions %}
<tr {% if submission.is_best %}style="background:color-mix(in oklch, var(--color-warning) 16%, transparent);"{% endif %}>
  <td class="font-mono font-{{ 'bold text-primary' if submission.is_best else 'semibold text-base-content/50' }}">
    #{{ submission.attempt }}
  </td>
  <td>
    <div class="flex items-center gap-2.5">
      <span class="font-mono font-semibold">{{ submission.filename }}</span>
      <span class="font-mono text-xs text-base-content/40">{{ submission.language }}</span>
      {% if submission.is_best %}
      <span class="badge badge-sm badge-warning border-none font-extrabold uppercase text-[10px] tracking-wide"
            style="color:oklch(99% 0 0);">Best · counts</span>
      {% endif %}
    </div>
  </td>
  <td class="text-sm text-base-content/60">{{ submission.enqueued | datetime }}</td>
  <td class="text-right font-mono text-sm text-base-content/60">{{ submission.elapsed_s | duration }}</td>
  <td class="text-right">
    {% if submission.status == "queued" %}
    <span class="badge badge-ghost gap-1.5 font-mono font-semibold">queued</span>
    {% elif submission.status == "running" %}
    <span class="badge badge-ghost gap-1.5 font-mono font-semibold">
      <span class="loading loading-spinner loading-xs"></span>running
    </span>
    {% elif submission.score is none %}
    <span class="badge badge-ghost gap-1.5 font-mono font-semibold">no tests</span>
    {% else %}
    {# Class names are spelled out rather than built from a variable: Tailwind
       only emits the utilities it can literally see in these templates. #}
    {% if submission.score >= 0.9 %}
    {% set badge = "badge-success" %}
    {% set dot = "bg-success" %}
    {% set tint = "background:color-mix(in oklch, var(--color-success) 16%, transparent);color:oklch(38% 0.1 150);" %}
    {% elif submission.score >= 0.5 %}
    {% set badge = "badge-warning" %}
    {% set dot = "bg-warning" %}
    {% set tint = "background:color-mix(in oklch, var(--color-warning) 18%, transparent);color:oklch(45% 0.12 55);" %}
    {% else %}
    {% set badge = "badge-error" %}
    {% set dot = "bg-error" %}
    {% set tint = "background:color-mix(in oklch, var(--color-error) 14%, transparent);color:oklch(45% 0.15 28);" %}
    {% endif %}
    <span class="badge {{ badge }} gap-1.5 font-mono font-bold border-none"
          style="{{ tint }}"
          title="{{ submission.n_passed }} of {{ submission.n_tests }} tests passed">
      <span class="h-1.5 w-1.5 rounded-full {{ dot }}"></span>{{ submission.score | score }} / 100
    </span>
    {% endif %}
  </td>
</tr>
{% else %}
<tr>
  <td colspan="5" class="text-center text-sm text-base-content/45 py-6">
    No attempts yet — upload a solution to get started.
  </td>
</tr>
{% endfor %}
