{# Rows for #submission-history. Polled every 2s, so it has to render
   submissions that are still queued or running and have no outcomes yet.

   Rendered both by the student's own challenge page and by the staff view of
   one student, so the link out to a submission is written once here and works
   from both. #}
{% for submission in submissions %}
{% set href = url_for('get_submission', submission_id=submission.id) %}
{# The whole row is clickable for convenience; the filename is a real link so
   the page is still reachable with a keyboard. #}
<tr class="hover cursor-pointer" onclick="location.href='{{ href }}'"
    {% if submission.is_best %}style="background:color-mix(in oklch, var(--color-warning) 16%, transparent);"{% endif %}>
  <td class="font-mono font-{{ 'bold text-primary' if submission.is_best else 'semibold text-base-content/50' }}">
    #{{ submission.attempt }}
  </td>
  <td>
    <div class="flex items-center gap-2.5">
      <a href="{{ href }}" class="font-mono font-semibold hover:text-primary">{{ submission.filename }}</a>
      <span class="font-mono text-xs text-base-content/40">{{ submission.language }}</span>
      {% if submission.is_best %}
      <span class="badge badge-sm badge-warning border-none font-extrabold uppercase text-[10px] tracking-wide"
            style="color:oklch(99% 0 0);">Best · counts</span>
      {% endif %}
    </div>
  </td>
  <td class="text-sm text-base-content/60">{{ submission.enqueued | datetime }}</td>
  <td class="text-right font-mono text-sm text-base-content/60">{{ submission.elapsed_s | duration }}</td>
  <td class="text-right">
    {% if submission.status == "queued" %}
    <span class="badge badge-ghost gap-1.5 font-mono font-semibold">queued</span>
    {% elif submission.status == "running" %}
    <span class="badge badge-ghost gap-1.5 font-mono font-semibold">
      <span class="loading loading-spinner loading-xs"></span>running
    </span>
    {% elif submission.score is none %}
    <span class="badge badge-ghost gap-1.5 font-mono font-semibold">no tests</span>
    {% else %}
    {% with score = submission.score, n_passed = submission.n_passed, n_tests = submission.n_tests %}
    {% include "_score-badge.jinja" %}
    {% endwith %}
    {% endif %}
  </td>
</tr>
{% else %}
<tr>
  {# The staff view of a single student passes its own wording: "upload a
     solution" is advice for the author of the submissions, not for a teacher. #}
  <td colspan="5" class="text-center text-sm text-base-content/45 py-6">
    {{ empty_message or "No attempts yet — upload a solution to get started." }}
  </td>
</tr>
{% endfor %}
