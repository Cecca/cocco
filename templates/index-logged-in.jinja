{% extends "base.jinja" %}
{% block title %}
{{ title }}
{% endblock %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  <!-- ══ THE COURSES ═════════════════════════════════════════════════ -->
  {# The card `course.jinja` opens with: mono eyebrow, serif title, the one
     affordance staff get, and here the filter box. #}
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-8">
      <div class="flex items-start justify-between gap-4">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
          Coding Challenges Companion
        </p>
        {# Only an administrator is offered these; `require_admin` behind both
           routes is what actually stops everyone else. The admin page is
           reached from here rather than from the navbar because this context is
           the only one that already knows the answer - putting the link in
           `base.jinja` would mean threading `is_admin` through every page. #}
        {% if is_admin %}
        <div class="flex items-center gap-2 -mt-1">
          <a href="{{ url_for('get_admin') }}"
             class="btn btn-sm btn-ghost border border-base-300 font-semibold">
            Administration
          </a>
          <a href="{{ url_for('get_course_new') }}"
             class="btn btn-sm btn-ghost border border-base-300 font-semibold">
            New course
          </a>
        </div>
        {% endif %}
      </div>
      <h1 class="font-serif text-4xl font-semibold tracking-tight mt-1 mb-4">Courses</h1>

      {# Outside `#courses`, which is what the swap replaces: an input inside
         its own target would be rebuilt on every keystroke and lose focus. #}
      <input type="search" name="q" value="{{ q }}"
             placeholder="Filter courses by name…"
             aria-label="Filter courses by name"
             class="input w-full"
             hx-get="{{ url_for('get_fragment_courses') }}"
             hx-trigger="input changed delay:200ms, search"
             hx-include="this"
             hx-target="#courses"
             hx-swap="innerHTML" />
    </div>
  </div>

  <div id="courses" class="mt-8">
    {% include "f-courses.jinja" %}
  </div>
</main>
{% endblock %}
