{% extends "base.jinja" %}
{% block title %}
{{ title }}
{% endblock %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  <!-- ══ THE COURSES ═════════════════════════════════════════════════ -->
  {# The card `course.jinja` opens with: mono eyebrow, serif title, the one
     affordance staff get, and here the filter box. #}
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-8">
      <div class="flex items-start justify-between gap-4">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
          Coding Challenges Companion
        </p>
        {# Only an administrator is offered this; `require_admin` behind the route is
           what actually stops everyone else. #}
        {% if is_admin %}
        <a href="{{ url_for('get_course_new') }}"
           class="btn btn-sm btn-ghost border border-base-300 font-semibold -mt-1">
          New course
        </a>
        {% endif %}
      </div>
      <h1 class="font-serif text-4xl font-semibold tracking-tight mt-1 mb-4">Courses</h1>

      {# Outside `#courses`, which is what the swap replaces: an input inside
         its own target would be rebuilt on every keystroke and lose focus. #}
      <input type="search" name="q" value="{{ q }}"
             placeholder="Filter courses by name…"
             aria-label="Filter courses by name"
             class="input w-full"
             hx-get="{{ url_for('get_fragment_courses') }}"
             hx-trigger="input changed delay:200ms, search"
             hx-include="this"
             hx-target="#courses"
             hx-swap="innerHTML" />
    </div>
  </div>

  <div id="courses" class="mt-8">
    {% include "f-courses.jinja" %}
  </div>
</main>
{% endblock %}
