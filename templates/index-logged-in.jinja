{% extends "base.jinja" %}
{% block title %}
{{ title }}
{% endblock %}

{% block content %}
<div class="flex items-center justify-between gap-4 mb-6">
  <h1 class="text-3xl font-bold">Courses</h1>
  {# Only an administrator is offered this; `require_admin` behind the route is
     what actually stops everyone else. #}
  {% if can_create_course %}
  <a href="{{ url_for('get_course_new') }}"
     class="btn btn-sm btn-ghost border border-base-300 font-semibold">
    New course
  </a>
  {% endif %}
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {% for course in courses.enrolled %}
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">{{ course.title }}</h2>
        <p>{{ course.description }}</p>
        <div class="card-actions justify-end">
          <a href="{{ url_for('get_course', course_id=course.id) }}">
          <button class="btn btn-primary">Go!</button>
          </a>
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<div class="divider">other courses</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {% for course in courses.non_enrolled %}
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">{{ course.title }}</h2>
        <p>{{ course.description }}</p>
        <div class="card-actions justify-end">
          <button class="btn btn-secondary">Enroll!</button>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
{% endblock %}

