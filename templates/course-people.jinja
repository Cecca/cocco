{% extends "base.jinja" %}
{% block title %}{{ title }}{% endblock %}

{% set crumbs = [
  {"label": "Courses", "href": url_for('index')},
  {"label": course.title, "href": url_for('get_course', course_id=course.id)},
  {"label": "People"},
] %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  <!-- ══ THE CLASS ═══════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-8">
      <div class="flex items-center justify-end">
        <a href="{{ url_for('get_course', course_id=course.id) }}"
           class="btn btn-sm btn-ghost border border-base-300 font-semibold">
          ← Back to course
        </a>
      </div>
      <h1 class="font-serif text-4xl font-semibold tracking-tight mb-1">People</h1>
      <p class="text-[13px] text-base-content/55 mb-5">
        Everyone enrolled on {{ course.title }}. Teachers and collaborators are
        course staff — they see the standings and may edit the challenges.
        Students submit to them.
      </p>

      {# Outside `#people`, like the filter box below it and for a reason one
         step further on: the filter re-renders that div on every keystroke, so
         an enroll form inside it would have a half-typed address wiped by
         somebody typing in the box. #}
      <div class="pb-5 mb-5 border-b border-base-300">
      <form hx-post="{{ url_for('post_course_person', course_id=course.id) }}"
            hx-target="#people"
            hx-swap="innerHTML"
            hx-disabled-elt="find button"
            class="flex flex-wrap items-end gap-2">
        {# Carried on every mutation, so enrolling somebody under a filter
           leaves the filter in force - the same reason `post_course_enroll`
           carries `q`. #}
        <input type="hidden" name="q" value="{{ q }}" />
        <label class="flex-1 min-w-64">
          <span class="block text-[13px] font-semibold mb-1.5">
            Enrol somebody
          </span>
          <input type="email" name="email" required autocomplete="off"
                 placeholder="somebody@unipd.it"
                 class="input w-full" />
        </label>
        <label>
          <span class="block text-[13px] font-semibold mb-1.5">as a</span>
          <select name="new_role" class="select font-mono">
            {% for role_name in USER_ROLE_NAMES %}
            <option value="{{ role_name }}"
                    {% if role_name == "student" %}selected{% endif %}>
              {{ role_name }}
            </option>
            {% endfor %}
          </select>
        </label>
        <button type="submit" class="btn btn-primary shadow-md shadow-primary/30">
          <span class="submit-label">Enrol</span>
          <span class="htmx-indicator loading loading-spinner loading-sm"></span>
        </button>
      </form>
      <p class="text-[13px] text-base-content/45 mt-2">
        They do not need an account yet — one is created for the address, and it
        is waiting for them the first time they sign in with Google.
      </p>
      </div>

      {# Outside `#people`, which is what the swap replaces: an input inside its
         own target would be rebuilt on every keystroke and lose focus. #}
      <input type="search" name="q" value="{{ q }}"
             placeholder="Filter people by name or address…"
             aria-label="Filter people by name or address"
             class="input w-full"
             hx-get="{{ url_for('get_fragment_course_people', course_id=course.id) }}"
             hx-trigger="input changed delay:200ms, search"
             hx-include="this"
             hx-target="#people"
             hx-swap="innerHTML" />
    </div>
  </div>

  <div id="people" class="mt-8">
    {% include "f-course-people.jinja" %}
  </div>
</main>
{% endblock %}
