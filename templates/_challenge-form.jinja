{# The challenge form, shared by the editor and the create page: they write the
   same columns, so they are the same form and are validated by the same
   `_challenge_fields`.

   Context: action_url, challenge (a row, or the defaults dict the create page
   passes - Jinja falls back to __getitem__, so both work), submit_label, and
   show_title, which is true only where there is no title yet. #}

<form hx-post="{{ action_url }}"
      hx-target="#edit-result"
      hx-swap="innerHTML">

  {% if show_title %}
  <!-- ══ TITLE ═════════════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg">Title</h2>
      <p class="text-[13px] text-base-content/55 -mt-1">
        How the challenge is listed on the course page.
      </p>
      <input type="text" name="title" required autofocus
             value="{{ challenge.title }}"
             placeholder="Two Sum"
             class="input w-full mt-3" />
    </div>
  </div>
  {% endif %}

  <!-- ══ PROBLEM STATEMENT ═════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-7">
      <div class="flex items-baseline justify-between">
        <h2 class="font-bold text-lg">Problem statement</h2>
        <span class="font-mono text-xs text-base-content/45">markdown</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-3">
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Source</label>
          <!-- Preview re-renders server-side through the same filter the
               challenge page uses, so it cannot drift from the real thing. -->
          <textarea name="description"
                    id="description"
                    rows="24"
                    class="textarea font-mono text-sm w-full mt-1.5 leading-relaxed"
                    hx-post="{{ url_for('post_markdown_preview') }}"
                    hx-trigger="load, keyup changed delay:400ms"
                    hx-target="#preview"
                    hx-swap="innerHTML">{{ challenge.description }}</textarea>
        </div>
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Preview</label>
          <div id="preview"
               class="rounded-xl border border-base-300 bg-base-200/40 p-5 mt-1.5 min-h-[10rem] overflow-x-auto">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ LEADERBOARD ═════════════════════════════════════════════════ -->
  <!-- Inside the same form as the limits below: one Save covers both, and the
       submit button lives at the end of that card. -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg">Leaderboard</h2>
      <p class="text-[13px] text-base-content/55 -mt-1">
        What the board on the challenge page ranks students by. Every student is
        represented by their single best submission.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Rank by</label>
          <select name="ranking" class="select w-full mt-1.5">
            <option value="running_time" {{ 'selected' if challenge.ranking == 'running_time' }}>
              Running time — fastest fully correct submission
            </option>
            <option value="total_score" {{ 'selected' if challenge.ranking == 'total_score' }}>
              Total score — points summed over all tests
            </option>
            <option value="average_score" {{ 'selected' if challenge.ranking == 'average_score' }}>
              Average score — mean score per test
            </option>
          </select>
        </div>
        <p class="text-[13px] text-base-content/55 sm:mt-6">
          Ranking by time shows only students who passed every test; the two score
          rankings include partially correct submissions. Both score rankings assume
          higher is better, so neither suits an evaluator that scores an error.
        </p>
      </div>
    </div>
  </div>

  <!-- ══ SANDBOX LIMITS ══════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg">Sandbox limits</h2>
      <p class="text-[13px] text-base-content/55 -mt-1">
        Enforced by isolate on every run. Too tight and correct solutions get killed.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3">
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Time (s)</label>
          <input type="number" name="max_time_s" step="0.5" min="0.5" required
                 value="{{ challenge.max_time_s }}"
                 class="input font-mono w-full mt-1.5" />
        </div>
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Memory (MB)</label>
          <input type="number" name="max_memory_mb" step="1" min="1" required
                 value="{{ (challenge.max_memory_bytes / 1024 / 1024) | round | int }}"
                 class="input font-mono w-full mt-1.5" />
        </div>
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Threads</label>
          <input type="number" name="max_threads" step="1" min="1" required
                 value="{{ challenge.max_threads }}"
                 class="input font-mono w-full mt-1.5" />
        </div>
      </div>

      <div class="flex items-center gap-4 mt-5">
        <button type="submit" class="btn btn-primary shadow-md shadow-primary/30">
          <span class="submit-label">{{ submit_label }}</span>
          <span class="htmx-indicator loading loading-spinner loading-sm"></span>
        </button>
        {# Where the alert lands on a failure. On a successful create there is
           nothing to swap: the response is a 204 carrying HX-Redirect. #}
        <div id="edit-result" class="empty:hidden flex-1"></div>
      </div>
    </div>
  </div>
</form>
