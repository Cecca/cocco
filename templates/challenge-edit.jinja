{% extends "base.jinja" %}
{% block title %}Editing {{ challenge.title }}{% endblock %}

{% block nav_extra %}
<li><a class="text-base-content font-bold border-b-2 border-primary pb-0.5">Editing</a></li>
{% endblock %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
        <a href="{{ url_for('get_course', course_id=course_id) }}" class="hover:text-primary">
          {{ challenge.course_title }}
        </a>
        · Challenge {{ "%02d" | format(challenge.position) }}
      </p>
      <h1 class="font-serif text-3xl font-semibold tracking-tight mt-1">{{ challenge.title }}</h1>
    </div>
    <a href="{{ url_for('get_challenge', course_id=course_id, challenge_id=challenge.id) }}"
       class="btn btn-sm btn-ghost border border-base-300 font-semibold">
      ← Back to challenge
    </a>
  </div>

  {# The same form the create page shows, minus the title: a challenge is
     named once, when it is created. #}
  {% set action_url = url_for('post_challenge_edit', course_id=course_id, challenge_id=challenge.id) %}
  {% set show_title = false %}
  {% set submit_label = "Save changes" %}
  {% include "_challenge-form.jinja" %}

  {# Outside the form above, like the test cases below it: nested forms are
     invalid HTML, and this card has upload and reset forms of its own. Above
     the test cases because you pick the checker before writing what it
     checks. #}
  <!-- ══ EVALUATOR ═════════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg">Evaluator</h2>
      <p class="text-[13px] text-base-content/55 -mt-1 mb-3">
        The script that turns a submission's output into a score. It runs in the
        same sandbox as submissions — in any language this judge supports, picked
        from the file's extension — once per test case, as
        <code class="text-xs">script &lt;actual&gt; &lt;expected&gt; &lt;input&gt;</code>,
        and must print one JSON object on stdout:
        <code class="text-xs">{"score": 0.5, "message": "shown to the student"}</code>.
        Exiting non-zero means the checker broke, never that the answer was wrong.
        Changing the evaluator does not rescore anything already submitted — use
        Regrade on the challenge page for that.
      </p>

      <!-- Every mutation returns this whole card, so it always matches the database -->
      <div id="evaluator">
        {% include "f-evaluator.jinja" %}
      </div>
    </div>
  </div>

  <!-- ══ TEST CASES ════════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg">Test cases</h2>
      <p class="text-[13px] text-base-content/55 -mt-1 mb-3">
        Run in order. Public samples are downloadable from the challenge page; the rest stay hidden.
      </p>

      <!-- Every mutation returns this whole list, so it always matches the database -->
      <div id="testcases">
        {% include "f-testcases.jinja" %}
      </div>
    </div>
  </div>
</main>
{% endblock %}
