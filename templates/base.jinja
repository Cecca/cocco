<html>
<head>
  <title>Cocco - {% block title %}{% endblock %}</title>
  <link href="{{ url_for('static', path='/styles.css') }}" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta2" integrity="sha384-v+EMKtNUAo5enmQxBqgoU/FWvVvvZHvITNzurHSl4kzvCs94wdlgHUci1lliKWKz" crossorigin="anonymous"></script>
</head>
<body class="bg-base-200 min-h-screen">
  <div class="navbar bg-base-100 shadow-sm">
    <div class="flex-1">
      <a class="btn btn-ghost text-xl">cocco</a>
    </div>
    <div class="flex-none flex items-center gap-3 px-4">
      <div class="flex flex-col items-end leading-tight">
        <span class="font-semibold">{{ user.nickname }}</span>
        <span class="text-sm opacity-70">{{ user.email }}</span>
      </div>
      <img src="{{ url_for('user_avatar', user_id=user.id) }}"
           alt="{{ user.nickname }}'s avatar"
           class="w-10 h-10 rounded-full bg-base-200 object-cover" />
    </div>
  </div>

  <div class="container mx-auto lg:max-w-1/2 px-4 py-8">
  {% block content %}  
  Placeholder
  {% endblock  %}  
  </div>
</body>
</html>


