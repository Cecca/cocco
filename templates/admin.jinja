{% extends "base.jinja" %}
{% block title %}{{ title }}{% endblock %}

{# Not under a course, so the trail starts here rather than hanging off
   "Courses" - the same reason the profile's does. #}
{% set crumbs = [{"label": "Administration"}] %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  <!-- ══ THE SITE ════════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-8">
      <div class="flex items-start justify-between gap-4">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
          Administration
        </p>
        <a href="{{ url_for('index') }}"
           class="btn btn-sm btn-ghost border border-base-300 font-semibold -mt-1">
          ← Back to courses
        </a>
      </div>
      <h1 class="font-serif text-4xl font-semibold tracking-tight mt-1 mb-1">Users</h1>
      <p class="text-[13px] text-base-content/55 mb-5">
        Everyone this server knows about. An administrator may create courses and
        is course staff on every one of them.
      </p>

      {# Outside `#users`, like the filter box below it and for a reason one step
         further on: the filter re-renders that div on every keystroke, so an
         appoint form inside it would have a half-typed address wiped by
         somebody typing in the box. #}
      <form hx-post="{{ url_for('post_administrator') }}"
            hx-target="#users"
            hx-swap="innerHTML"
            hx-disabled-elt="find button"
            class="flex flex-wrap items-end gap-2 pb-5 mb-5 border-b border-base-300">
        {# Carried on every mutation, so appointing someone under a filter
           leaves the filter in force - the same reason `post_course_enroll`
           carries `q`. #}
        <input type="hidden" name="q" value="{{ q }}" />
        <label class="flex-1 min-w-64">
          <span class="block text-[13px] font-semibold mb-1.5">
            Appoint an administrator
          </span>
          <input type="email" name="email" required autocomplete="off"
                 placeholder="somebody@unipd.it"
                 class="input w-full" />
        </label>
        <button type="submit" class="btn btn-primary shadow-md shadow-primary/30">
          <span class="submit-label">Appoint</span>
          <span class="htmx-indicator loading loading-spinner loading-sm"></span>
        </button>
      </form>

      {# Outside `#users`, which is what the swap replaces: an input inside its
         own target would be rebuilt on every keystroke and lose focus. #}
      <input type="search" name="q" value="{{ q }}"
             placeholder="Filter people by name or address…"
             aria-label="Filter people by name or address"
             class="input w-full"
             hx-get="{{ url_for('get_fragment_users') }}"
             hx-trigger="input changed delay:200ms, search"
             hx-include="this"
             hx-target="#users"
             hx-swap="innerHTML" />
    </div>
  </div>

  <div id="users" class="mt-8">
    {% include "f-users.jinja" %}
  </div>
</main>
{% endblock %}
