{% extends "base.jinja" %}
{% block title %}Sign in{% endblock %}

{# A full page, and deliberately htmx-free: the Google flow leaves the site
   entirely and comes back through a redirect, which is exactly what htmx is
   bad at, and the password forms answer with this same page on a refusal.

   There are up to three ways in on this page and any combination of them may
   be configured, so the "or" between them cannot be hard-coded to one pair.
   `ns.shown` is the running answer to "has anything been drawn yet", and each
   block puts a divider in front of itself if something has. #}
{% set ns = namespace(shown=false) %}
{% block content %}
<div class="max-w-md mx-auto">
  <div class="card bg-base-100 border border-base-300">
    <div class="card-body gap-4">
      <h1 class="text-2xl font-extrabold">Sign in to COCCO</h1>

      {% if error %}
      <div class="alert alert-error text-sm">{{ error }}</div>
      {% endif %}

      {# The development sign-in: type an address, be that person. `[dev]
         dummy_auth` and nothing else puts this here, and `post_auth_dummy`
         404s without it - a hidden form is presentation, never the check. #}
      {% if dummy_auth %}
      <div class="alert alert-warning text-sm flex-col items-start gap-1">
        <span class="font-semibold">Development sign-in</span>
        <span>
          <code>[dev] dummy_auth</code> is on, so anyone may sign in as anyone
          here, with no password and no Google. Never turn this on in public.
        </span>
      </div>
      <form method="post" action="{{ url_for('post_auth_dummy') }}"
            class="flex flex-col gap-2">
        <input type="hidden" name="next" value="{{ next }}">
        <label class="form-control">
          <span class="label-text text-sm">Sign in as</span>
          <input type="email" name="email" autofocus required
                 class="input input-bordered w-full"
                 placeholder="{{ dummy_admin }}">
        </label>
        <button type="submit" class="btn btn-primary w-full">Sign in</button>
      </form>
      <p class="text-xs opacity-60">
        The seeded cast: <code>{{ dummy_admin }}</code> (site administrator),
        {% for email in dummy_teachers %}<code>{{ email }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        (teaches every course), and
        {% for email in dummy_students %}<code>{{ email }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        (students). Any other address in an accepted domain creates a fresh
        account with no enrollments.
      </p>
      {% set ns.shown = true %}
      {% endif %}

      {# An address and a password. `[auth] password_login` draws it, and the
         two routes behind it 404 without that setting, for the reason above.

         Signing in is two fields and nothing else; creating an account is
         folded into a `<details>`, because almost everybody who reaches this
         page already has one and the common case should not have to read past
         a registration form to find the box they want. #}
      {% if password_login %}
      {% if ns.shown %}<div class="divider text-xs">or</div>{% endif %}
      <form method="post" action="{{ url_for('post_auth_password') }}"
            class="flex flex-col gap-2">
        <input type="hidden" name="next" value="{{ next }}">
        <label class="form-control">
          <span class="label-text text-sm">Email address</span>
          <input type="email" name="email" required autocomplete="username"
                 class="input input-bordered w-full">
        </label>
        <label class="form-control">
          <span class="label-text text-sm">Password</span>
          <input type="password" name="password" required
                 autocomplete="current-password"
                 class="input input-bordered w-full">
        </label>
        <button type="submit" class="btn btn-primary w-full">Sign in</button>
      </form>

      <details class="text-sm">
        <summary class="cursor-pointer opacity-70 hover:opacity-100">
          I do not have an account yet
        </summary>
        <form method="post" action="{{ url_for('post_auth_password_register') }}"
              class="flex flex-col gap-2 mt-3">
          <input type="hidden" name="next" value="{{ next }}">
          <label class="form-control">
            <span class="label-text text-sm">Email address</span>
            <input type="email" name="email" required autocomplete="username"
                   class="input input-bordered w-full">
          </label>
          <label class="form-control">
            <span class="label-text text-sm">Choose a password</span>
            <input type="password" name="password" required
                   minlength="{{ min_password_length }}"
                   autocomplete="new-password"
                   class="input input-bordered w-full">
          </label>
          <label class="form-control">
            <span class="label-text text-sm">And again</span>
            <input type="password" name="confirm" required
                   minlength="{{ min_password_length }}"
                   autocomplete="new-password"
                   class="input input-bordered w-full">
          </label>
          <button type="submit" class="btn btn-outline w-full">
            Create an account
          </button>
          <p class="text-xs opacity-60">
            At least {{ min_password_length }} characters. An address that has
            already been signed in with cannot be claimed here — if it is
            yours and you have forgotten the password, ask a site
            administrator to issue a new one.
          </p>
        </form>
      </details>
      {% set ns.shown = true %}
      {% endif %}

      {% if google_configured %}
      {% if ns.shown %}<div class="divider text-xs">or</div>{% endif %}
      <p class="text-sm opacity-70">
        Sign in with your institutional Google account. No password, and no
        account to create first — your first sign-in creates one.
      </p>
      <a class="btn btn-primary w-full"
         href="{{ url_for('get_auth_google').include_query_params(next=next) }}">
        Sign in with Google
      </a>
      {% set ns.shown = true %}
      {% endif %}

      {% if ns.shown %}
      <p class="text-xs opacity-60">
        Accepted addresses:
        {% for domain in allowed_domains %}<code>@{{ domain }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        and their subdomains.
      </p>
      {% else %}
      {# Only when there is no way in at all: under `[dev] dummy_auth`, or with
         passwords on, this would be a warning about the absence of a thing
         nobody is looking for. #}
      <div class="alert alert-warning text-sm flex-col items-start gap-1">
        <span class="font-semibold">No sign-in method is configured</span>
        <span>
          Put <code>COCCO_GOOGLE_CLIENT_ID</code> and
          <code>COCCO_GOOGLE_CLIENT_SECRET</code> in the environment — they have
          no spelling in <code>cocco.toml</code>; see
          <code>cocco.example.toml</code>. Or set
          <code>password_login = true</code> under <code>[auth]</code> to sign
          in with an address and a password instead. In development, set
          <code>dummy_auth = true</code> under <code>[dev]</code>, as
          <code>cocco.dev.toml</code> does.
        </span>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
