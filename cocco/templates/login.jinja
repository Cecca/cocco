{% extends "base.jinja" %}
{% block title %}Sign in{% endblock %}

{# A full page, and deliberately htmx-free: the flow leaves the site entirely
   and comes back through a redirect, which is exactly what htmx is bad at. #}
{% block content %}
<div class="max-w-md mx-auto">
  <div class="card bg-base-100 border border-base-300">
    <div class="card-body gap-4">
      <h1 class="text-2xl font-extrabold">Sign in to COCCO</h1>

      {% if error %}
      <div class="alert alert-error text-sm">{{ error }}</div>
      {% endif %}

      {# The development sign-in: type an address, be that person. `[dev]
         dummy_auth` and nothing else puts this here, and `post_auth_dummy`
         404s without it - a hidden form is presentation, never the check. #}
      {% if dummy_auth %}
      <div class="alert alert-warning text-sm flex-col items-start gap-1">
        <span class="font-semibold">Development sign-in</span>
        <span>
          <code>[dev] dummy_auth</code> is on, so anyone may sign in as anyone
          here, with no password and no Google. Never turn this on in public.
        </span>
      </div>
      <form method="post" action="{{ url_for('post_auth_dummy') }}"
            class="flex flex-col gap-2">
        <input type="hidden" name="next" value="{{ next }}">
        <label class="form-control">
          <span class="label-text text-sm">Sign in as</span>
          <input type="email" name="email" autofocus required
                 class="input input-bordered w-full"
                 placeholder="{{ dummy_admin }}">
        </label>
        <button type="submit" class="btn btn-primary w-full">Sign in</button>
      </form>
      <p class="text-xs opacity-60">
        The seeded cast: <code>{{ dummy_admin }}</code> (site administrator),
        {% for email in dummy_teachers %}<code>{{ email }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        (teaches every course), and
        {% for email in dummy_students %}<code>{{ email }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        (students). Any other address in an accepted domain creates a fresh
        account with no enrollments.
      </p>
      {% if google_configured %}<div class="divider text-xs">or</div>{% endif %}
      {% endif %}

      {% if google_configured %}
      <p class="text-sm opacity-70">
        Sign in with your institutional Google account. There is no password and
        no account to create first — your first sign-in creates one.
      </p>
      <a class="btn btn-primary w-full"
         href="{{ url_for('get_auth_google').include_query_params(next=next) }}">
        Sign in with Google
      </a>
      <p class="text-xs opacity-60">
        Accepted addresses:
        {% for domain in allowed_domains %}<code>@{{ domain }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        and their subdomains.
      </p>
      {% elif not dummy_auth %}
      {# Only when there is no other way in: under `[dev] dummy_auth` the box
         above is the way in, and this would be a warning about the absence of
         a thing nobody is looking for. #}
      <div class="alert alert-warning text-sm flex-col items-start gap-1">
        <span class="font-semibold">Google sign-in is not configured</span>
        <span>
          Put <code>COCCO_GOOGLE_CLIENT_ID</code> and
          <code>COCCO_GOOGLE_CLIENT_SECRET</code> in the environment — they have
          no spelling in <code>cocco.toml</code>; see
          <code>cocco.example.toml</code>. In development, set
          <code>dummy_auth = true</code> under <code>[dev]</code> instead, as
          <code>cocco.dev.toml</code> does.
        </span>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
