{% extends "base.jinja" %}
{% block title %}{{ challenge.title }}{% endblock %}

{% set crumbs = [
  {"label": "Courses", "href": url_for('index')},
  {"label": challenge.course_title, "href": url_for('get_course', course_id=course_id)},
  {"label": challenge.title},
] %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  {# Staff land on challenge-staff.jinja; they reach this page through
     ?as=student, so give them the way back. #}
  {% if viewing_as_student %}
  <div class="flex items-center gap-3 rounded-xl border border-base-300 bg-base-200/50 px-4 py-2.5 mb-5">
    <span class="text-sm text-base-content/60">
      You are looking at this challenge the way a student does.
    </span>
    <a href="{{ url_for('get_challenge', course_id=course_id, challenge_id=challenge.id) }}"
       class="btn btn-xs btn-ghost border border-base-300 font-semibold ml-auto">
      ← Back to the staff view
    </a>
  </div>
  {% endif %}

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_22rem] gap-6 items-start">

    <!-- ── LEFT: problem + sample files ─────────────────────────────── -->
    {% include "_statement.jinja" %}

    <!-- ── RIGHT: submit + leaderboard ──────────────────────────────── -->
    <div class="flex flex-col gap-5">

      {# Archived: readable, but not taking submissions. The form goes rather
         than being disabled, because there is nothing to fill in - and
         `post_submission` refuses in any case, which is the actual check.
         `effective_archived_at`, so archiving the course closes this too. #}
      {% if challenge.effective_archived_at %}
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body p-5">
          <h2 class="font-bold text-[15px]">Archived</h2>
          <p class="text-xs text-base-content/55 -mt-1">
            This challenge is no longer taking submissions. The statement, your
            attempts and the leaderboard stay here for reference.
          </p>
        </div>
      </div>
      {% else %}

      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body p-5">
          <h2 class="font-bold text-[15px]">Submit a solution</h2>
          <p class="text-xs text-base-content/55 -mt-1">Hand in as many as you like — your best score counts.</p>

          <!-- The language is derived server-side from the file extension, so
               there is no picker. The result alert lands in #submit-result;
               the history table below picks the new attempt up on its next poll. -->
          <form hx-post="{{ url_for('post_submission', course_id=course_id, challenge_id=challenge.id) }}"
                hx-encoding="multipart/form-data"
                hx-target="#submit-result"
                hx-swap="innerHTML"
                class="mt-2">

            <label class="cocco-dropzone flex flex-col items-center gap-2 rounded-xl bg-base-100 px-4 py-6 text-center cursor-pointer"
                   id="dropzone">
              <span class="grid h-9 w-9 place-items-center rounded-lg border-2 border-primary text-primary text-xl font-bold">↑</span>
              <span class="text-sm font-semibold" id="dropzone-label">Drag a file here or <span class="link link-primary">browse</span></span>
              <span class="font-mono text-xs text-base-content/45">.py · .c · .cpp · .java · ≤ 1 MB</span>
              <input type="file" name="solution" accept=".py,.c,.cpp,.cc,.cxx,.java" class="hidden" id="file-input" required />
            </label>

            <button type="submit" class="btn btn-primary w-full mt-3.5 shadow-md shadow-primary/30">
              <span class="submit-label">Run &amp; submit</span>
              <span class="htmx-indicator loading loading-spinner loading-sm"></span>
            </button>
          </form>

          <div id="submit-result" class="empty:hidden mt-4"></div>
        </div>
      </div>
      {% endif %}

      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body p-5">
          <div class="flex items-center justify-between">
            <h2 class="font-bold text-[15px]">
              {% if challenge.ranking == 'total_score' %}Top total scores
              {% elif challenge.ranking == 'average_score' %}Top average scores
              {% else %}Fastest solutions{% endif %}
            </h2>
            <span class="font-mono text-xs text-success flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-success"></span>live
            </span>
          </div>
          <p class="text-xs text-base-content/55 -mt-1 mb-2">
            {% if challenge.ranking == 'total_score' %}
            Points scored across all tests by each student's best submission
            {% elif challenge.ranking == 'average_score' %}
            Average per-test score of each student's best submission
            {% else %}
            Total running time of each student's fastest correct submission
            {% endif %}
          </p>

          <div id="leaderboard"
               hx-get="{{ url_for('get_fragment_leaderboard', challenge_id=challenge.id) }}"
               hx-trigger="load, every 15s"
               hx-swap="innerHTML"
               class="flex flex-col gap-0.5">
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ══ SUBMISSION HISTORY ══════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-7">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-lg">Your submissions</h2>
      </div>
      <p class="flex items-center gap-2 text-[13px] text-base-content/55 mb-3">
        <span class="h-2 w-2 rounded-sm bg-primary"></span>
        Your best score counts — earlier attempts stay here for reference.
      </p>

      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr class="text-xs uppercase tracking-wider text-base-content/45 font-mono">
              <th class="w-20">Attempt</th>
              <th>File</th>
              <th class="w-52">Submitted</th>
              <th class="w-28 text-right">Time</th>
              <th class="w-40 text-right">Result</th>
            </tr>
          </thead>
          <!-- Polled: a freshly queued submission shows up here within ~2s and
               keeps updating as the judge works through its test cases. -->
          <tbody id="submission-history"
                 hx-get="{{ url_for('get_fragment_submissions', challenge_id=challenge.id) }}"
                 hx-trigger="load, every 2s"
                 hx-swap="innerHTML">
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

{# Guarded by the same condition as the form itself: without it
   `getElementById("file-input")` is null and the first `addEventListener`
   throws, taking the rest of the page's scripts with it. #}
{% if not challenge.effective_archived_at %}
<script>
  // Reflect the chosen file in the dropzone + basic drag styling.
  // (htmx does the actual multipart upload on form submit.)
  const dz    = document.getElementById("dropzone");
  const input = document.getElementById("file-input");
  const label = document.getElementById("dropzone-label");

  input.addEventListener("change", () => {
    if (input.files.length) label.textContent = input.files[0].name;
  });
  ["dragover", "dragenter"].forEach(ev =>
    dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add("dragover"); }));
  ["dragleave", "drop"].forEach(ev =>
    dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove("dragover"); }));
  dz.addEventListener("drop", e => {
    if (e.dataTransfer.files.length) {
      input.files = e.dataTransfer.files;
      label.textContent = input.files[0].name;
    }
  });
</script>
{% endif %}
{% endblock %}
