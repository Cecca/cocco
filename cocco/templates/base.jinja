{# Bound once and used twice, below and in the navbar. A preload whose href
   differs from the `src` by a single byte fetches the image twice, which is
   exactly the mistake a `?v=` invites. #}
{% set logo_url = static_url('icon-small.png') %}<!DOCTYPE html>
<html lang="en" data-theme="cocco">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cocco - {% block title %}{% endblock %}</title>
  <link rel="icon" type="image/x-icon" href="{{ static_url('favicon.ico') }}">
  {# Above the stylesheet on purpose: the preload scanner promotes the mark
     instead of queueing it behind render-blocking CSS, which is what left the
     navbar painting an empty box with the logo dropping in a beat later. #}
  <link rel="preload" as="image" href="{{ logo_url }}" fetchpriority="high">
  <link href="{{ static_url('styles.css') }}" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta2" integrity="sha384-v+EMKtNUAo5enmQxBqgoU/FWvVvvZHvITNzurHSl4kzvCs94wdlgHUci1lliKWKz" crossorigin="anonymous"></script>
</head>
<body class="font-sans text-base-content min-h-screen">
  <div class="navbar bg-base-100 border-b border-base-300 px-6 min-h-[3.75rem]">
    <div class="flex-1 flex items-center gap-7">
      <a href="{{ url_for('index') }}" class="flex items-center gap-2.5">
        {# `alt=""` deliberately: the mark is decorative, and the accessible
           name of this link is the wordmark beside it. A non-empty alt would
           have a screen reader announce the link twice. #}
        <img src="{{ logo_url }}" width="64" height="64" alt="" fetchpriority="high" class="h-8 w-8">
        <span class="text-lg font-extrabold tracking-wide rounded-lg bg-primary text-primary-content px-2">COCCO</span>
      </a>
      {# The breadcrumb trail. A page declares it as data - a top-level
         `{% set crumbs = [...] %}`, which runs before this template does - and
         owns none of the markup, so every trail truncates and highlights the
         same way. A crumb with an `href` is a link; the one without is the page
         you are on, which is why no page has to say which of them is current.

         The trail is the whole of it: a page that is not under a course starts
         its own, and `/admin` therefore reads "Administration" rather than
         hanging off "Courses". A page that declares nothing - the login page,
         the blocked page - renders no trail at all. #}
      <ul class="cocco-crumbs hidden md:flex items-stretch gap-4 text-sm font-medium text-base-content/60"
          aria-label="Breadcrumb">
        {% for crumb in crumbs | default([]) %}
        <li>
          {% if crumb.href %}
          <a href="{{ crumb.href }}" class="max-w-[14rem] truncate hover:text-base-content"
             title="{{ crumb.label }}">{{ crumb.label }}</a>
          {% else %}
          <span class="max-w-[16rem] truncate text-base-content font-bold"
                aria-current="page" title="{{ crumb.label }}">{{ crumb.label }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {# The login page renders with no user, so everything below is guarded. #}
    {% if user %}
    <div class="dropdown dropdown-end">
      {% with oob = false %}{% include "_navbar-identity.jinja" %}{% endwith %}
      <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 mt-2 w-44 p-2 shadow border border-base-300">
        <li>
          <a href="{{ url_for('get_profile', user_id=user.id) }}">Profile</a>
        </li>
        <li>
          {# A plain form, so signing out works without JS, and a POST, so it
             cannot be triggered by a link someone else planted. #}
          <form method="post" action="{{ url_for('post_logout') }}">
            <button type="submit" class="w-full text-left">Sign out</button>
          </form>
        </li>
      </ul>
    </div>
    {% else %}
    <a href="{{ url_for('get_login') }}" class="btn btn-sm btn-primary">Sign in</a>
    {% endif %}
  </div>

  {% block body %}
  <div class="container mx-auto lg:max-w-1/2 px-4 py-8">
  {% block content %}
  Placeholder
  {% endblock %}
  </div>
  {% endblock %}
</body>
</html>
