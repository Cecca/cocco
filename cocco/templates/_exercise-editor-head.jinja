{# The exercise editor's assets, for a page's `head` block: the student page
   and the staff preview. CodeMirror 5.65.16, vendored under
   static/codemirror/ with its MIT licence; `exercise.js` is ours and says
   what it does with them. Deferred, so they run in this order once the page
   is parsed - the textareas they upgrade are there by then. #}
<link href="{{ static_url('codemirror/codemirror.css') }}" rel="stylesheet">
<script defer src="{{ static_url('codemirror/codemirror.js') }}"></script>
<script defer src="{{ static_url('codemirror/python.js') }}"></script>
<script defer src="{{ static_url('codemirror/matchbrackets.js') }}"></script>
<script defer src="{{ static_url('codemirror/closebrackets.js') }}"></script>
<script defer src="{{ static_url('exercise.js') }}"></script>
