{# The account's password, for the deployments that have `[auth]
   password_login` on. Every mutation returns this whole fragment, alert
   included, so the sentence and the new state arrive in one swap — `/admin`'s
   rule, and `f-tokens.jinja`'s shape next door. Rendered both standalone and
   inlined by profile.jinja.

   Context: profile_id; `password` — the row from `query_password_state`, or
   None when there is no password, which is what a Google-only account looks
   like; min_password_length; google_configured, which decides how alarming
   removing it is; message/ok. The password itself is never in here: only its
   scrypt hash is stored, and there is nowhere to read it back from. #}

{% if message %}
<div role="alert" class="alert {{ 'alert-success' if ok else 'alert-error' }} text-sm mb-4">
  <span>{{ message }}</span>
</div>
{% endif %}

{% if password %}
<p class="text-sm text-base-content/60 mb-4">
  A password is set. It was last changed {{ password.updated_at | datetime }}.
</p>
{% else %}
<p class="text-sm text-base-content/60 mb-4">
  No password is set on this account
  {%- if google_configured %}, so Google is the only way in{% endif -%}
  . Setting one lets you sign in without it.
</p>
{% endif %}

<form hx-post="{{ url_for('post_password', user_id=profile_id) }}"
      hx-target="#password" hx-swap="innerHTML"
      class="flex flex-col gap-3 max-w-sm">
  {% if password %}
  {# Required only when there is something to replace. A session left open on a
     shared machine is the ordinary way an account is taken, and without this
     whoever found it could lock its owner out; there is nothing to ask for
     before the first password, since the session is the only thing that could
     have reached this form. #}
  <label class="form-control">
    <span class="label-text text-sm">Current password</span>
    <input type="password" name="current_password" required
           autocomplete="current-password"
           class="input input-bordered w-full">
  </label>
  {% endif %}
  <label class="form-control">
    <span class="label-text text-sm">
      {{ "New password" if password else "Password" }}
    </span>
    <input type="password" name="password" required
           minlength="{{ min_password_length }}" autocomplete="new-password"
           class="input input-bordered w-full">
  </label>
  <label class="form-control">
    <span class="label-text text-sm">And again</span>
    <input type="password" name="confirm" required
           minlength="{{ min_password_length }}" autocomplete="new-password"
           class="input input-bordered w-full">
  </label>
  <div class="flex items-center gap-3">
    <button type="submit" class="btn btn-primary btn-sm">
      {{ "Change password" if password else "Set password" }}
    </button>
    <span class="text-xs text-base-content/55">
      At least {{ min_password_length }} characters.
    </span>
  </div>
</form>

{% if password %}
{# An inline form rather than the <dialog> a delete opens: nothing is destroyed
   that a new password does not replace, and the confirmation says what it
   costs. #}
<form hx-post="{{ url_for('post_password_delete', user_id=profile_id) }}"
      hx-target="#password" hx-swap="innerHTML"
      hx-confirm="{% if google_configured %}Remove the password from this account? You will sign in with Google.{% else %}Remove the password from this account? It is the only way in, and a site administrator would have to issue a new one.{% endif %}"
      class="mt-5 pt-5 border-t border-base-300">
  <button type="submit" class="btn btn-ghost btn-sm text-error">
    Remove password
  </button>
</form>
{% endif %}
