{% extends "base.jinja" %}
{% block title %}Editing {{ challenge.title }}{% endblock %}

{% set crumbs = [
  {"label": "Courses", "href": url_for('index')},
  {"label": challenge.course_title, "href": url_for('get_course', course_id=course_id)},
  {"label": challenge.title,
   "href": url_for('get_challenge', course_id=course_id, challenge_id=challenge.id)},
  {"label": "Editing"},
] %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      {# What the trail does not say, the way `_statement.jinja` prints it. #}
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
        Challenge {{ "%02d" | format(challenge.number) }}
      </p>
      <h1 class="font-serif text-3xl font-semibold tracking-tight mt-1">{{ challenge.title }}</h1>
    </div>
    <a href="{{ url_for('get_challenge', course_id=course_id, challenge_id=challenge.id) }}"
       class="btn btn-sm btn-ghost border border-base-300 font-semibold">
      ← Back to challenge
    </a>
  </div>

  {# The same form the create page shows, minus the title: a challenge is
     named once, when it is created. #}
  {% set action_url = url_for('post_challenge_edit', course_id=course_id, challenge_id=challenge.id) %}
  {% set show_title = false %}
  {% set submit_label = "Save changes" %}
  {% include "_challenge-form.jinja" %}

  {# Outside the form above, like the test cases below it: nested forms are
     invalid HTML, and this card has upload and reset forms of its own. Above
     the test cases because you pick the checker before writing what it
     checks. #}
  <!-- ══ EVALUATOR ═════════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg">Evaluator</h2>
      <p class="text-[13px] text-base-content/55 -mt-1 mb-3">
        The script that turns a submission's output into a score. It runs in the
        same sandbox as submissions — in any language this judge supports, picked
        from the file's extension — once per test case, as
        <code class="text-xs">script &lt;actual&gt; &lt;expected&gt; &lt;input&gt;</code>,
        and must print one JSON object on stdout:
        <code class="text-xs">{"score": 0.5, "message": "shown to the student"}</code>.
        Exiting non-zero means the checker broke, never that the answer was wrong.
        Changing the evaluator does not rescore anything already submitted — use
        Regrade on the challenge page for that.
      </p>

      <!-- Every mutation returns this whole card, so it always matches the database -->
      <div id="evaluator">
        {% include "f-evaluator.jinja" %}
      </div>
    </div>
  </div>

  <!-- ══ TEST CASES ════════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg">Test cases</h2>
      <p class="text-[13px] text-base-content/55 -mt-1 mb-3">
        Run in order. Public samples are downloadable from the challenge page; the rest stay hidden.
      </p>

      <!-- Every mutation returns this whole list, so it always matches the database -->
      <div id="testcases">
        {% include "f-testcases.jinja" %}
      </div>
    </div>
  </div>

  <!-- ══ DANGER ZONE ═══════════════════════════════════════════════════ -->
  {# No `is_admin` guard, unlike the course editor's: the whole page is behind
     `ChallengeEditor`, which is already "administrators and course staff". #}
  <div class="card bg-base-100 border border-error/30 shadow-sm mt-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg text-error">Danger zone</h2>
      <div id="challenge-danger-result" class="empty:hidden mt-3"></div>

      <div class="flex flex-wrap items-center justify-between gap-4 mt-4 rounded-xl border border-base-300 p-4">
        <div class="min-w-0 flex-1">
          <h3 class="font-semibold">
            {{ "Unarchive this challenge" if challenge.archived_at else "Archive this challenge" }}
          </h3>
          <p class="text-[13px] text-base-content/55">
            {% if challenge.archived_at %}
            It is archived: the class still reads it and looks back over their
            attempts, and it takes no new submissions. Unarchiving reopens it.
            {% else %}
            The class keeps reading it — statement, samples, their attempts,
            the leaderboard — and stops being able to submit. You can still
            edit it, and you can undo this from here.
            {% endif %}
          </p>
          {# The one place in the app that reads `challenge.archived_at`, the
             challenge's *own* state, rather than `effective_archived_at`:
             this is exactly where the difference between the two has to be
             said out loud. Everywhere else, reading this column instead would
             silently un-archive every challenge under an archived course. #}
          {% if challenge.effective_archived_at and not challenge.archived_at %}
          <p class="text-[13px] text-warning mt-1">
            Its course is archived, so this challenge is read-only whatever
            this button says. Unarchive the course to change that.
          </p>
          {% endif %}
        </div>
        <form hx-post="{{ url_for('post_challenge_unarchive' if challenge.archived_at else 'post_challenge_archive', course_id=course_id, challenge_id=challenge.id) }}"
              hx-target="#challenge-danger-result"
              hx-swap="innerHTML"
              hx-disabled-elt="find button">
          <button type="submit" class="btn btn-sm btn-outline btn-warning font-semibold">
            {{ "Unarchive" if challenge.archived_at else "Archive" }}
          </button>
        </form>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 mt-4 rounded-xl border border-error/30 p-4">
        <div class="min-w-0 flex-1">
          <h3 class="font-semibold">Delete this challenge</h3>
          <p class="text-[13px] text-base-content/55">
            Every test case and its files, the evaluator, every submission ever
            made to it and every recorded score. There is no undo — archive it
            instead if you only want it closed.
          </p>
        </div>
        <button type="button" class="btn btn-sm btn-error font-semibold"
                onclick="delete_challenge_modal.showModal()">
          Delete challenge…
        </button>
      </div>
    </div>
  </div>
</main>

{# The course editor's dialog, for a challenge. Both are commented there. #}
<dialog id="delete_challenge_modal" class="modal">
  <div class="modal-box">
    <h3 class="font-bold text-lg text-error">Delete {{ challenge.title }}?</h3>
    <p class="py-3 text-sm text-base-content/70">
      Every test case of this challenge and both of its files, the evaluator,
      every submission ever made to it and every score are deleted for good.
      Nothing about this can be undone.
    </p>
    <p class="text-sm text-base-content/70">
      Type <span class="font-semibold">{{ challenge.title }}</span> below to confirm.
    </p>
    <input type="text" id="challenge-delete-confirm" name="confirm"
           autocomplete="off" data-expected="{{ challenge.title }}"
           aria-label="Type the challenge title to confirm"
           class="input w-full mt-3 font-mono" />
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-sm btn-ghost">Cancel</button>
      </form>
      <button type="button" id="challenge-delete-button" disabled
              class="btn btn-sm btn-error"
              hx-post="{{ url_for('post_challenge_delete', course_id=course_id, challenge_id=challenge.id) }}"
              hx-include="#challenge-delete-confirm"
              hx-target="#challenge-danger-result"
              hx-swap="innerHTML"
              onclick="delete_challenge_modal.close()">
        Delete for good
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<script>
  (() => {
    const field = document.getElementById("challenge-delete-confirm");
    const button = document.getElementById("challenge-delete-button");
    const check = () => {
      button.disabled = field.value.trim() !== field.dataset.expected.trim();
    };
    field.addEventListener("input", check);
    document.getElementById("delete_challenge_modal")
            .addEventListener("close", () => { field.value = ""; check(); });
    check();
  })();
</script>
{% endblock %}
