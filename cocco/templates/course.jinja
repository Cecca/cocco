{% extends "base.jinja" %}
{% block title %}{{ course.title }}{% endblock %}

{% set crumbs = [
  {"label": "Courses", "href": url_for('index')},
  {"label": course.title},
] %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  <!-- ══ THE COURSE ══════════════════════════════════════════════════ -->
  {# The same card `_statement.jinja` opens a challenge with: the staff
     affordances, the serif title, then the markdown body. The trail that used
     to head it is the navbar's now. #}
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-8">
      {# Course staff only. The real check is on the edit routes themselves. #}
      {% if can_edit %}
      <div class="flex items-center justify-end gap-2">
        <a href="{{ url_for('get_course_people', course_id=course.id) }}"
           class="btn btn-sm btn-ghost gap-1.5 font-semibold border border-base-300">
          <span class="text-primary">☺</span> People
        </a>
        <a href="{{ url_for('get_course_edit', course_id=course.id) }}"
           class="btn btn-sm btn-ghost gap-1.5 font-semibold border border-base-300">
          <span class="text-primary">✎</span> Edit course
        </a>
      </div>
      {% endif %}
      <h1 class="font-serif text-4xl font-semibold tracking-tight mb-4">
        {{ course.title }}
        {% if course.archived_at %}
        <span class="badge badge-warning badge-outline align-middle font-semibold">Archived</span>
        {% endif %}
      </h1>

      <article class="prose prose-sm max-w-none">
        {{ course.description | markdown }}
      </article>
    </div>
  </div>

  {# A non-member gets the course, not its contents: `get_course` never even
     fetched the challenges for them. What they get instead is the way in - the
     same fragment `post_course_enroll` swaps back when the key was wrong.
     `next` brings them here again once the row exists, and this page is then
     the course rather than a preview of it. #}
  {% if not is_member %}
  <div class="mt-8">
    {% with next = url_for('get_course', course_id=course.id).path, error = None %}
    {% include "f-enroll.jinja" %}
    {% endwith %}
  </div>
  {% else %}

  <!-- ══ CHALLENGES ══════════════════════════════════════════════════ -->
  <div class="flex items-baseline justify-between gap-4 mt-8 mb-3">
    <div>
      <h2 class="font-bold text-lg">Challenges</h2>
      <p class="text-[13px] text-base-content/55">
        In the order the course sets them. Your best score on each one counts.
      </p>
    </div>
    {# Course staff only. `require_course_editor` on the route behind it is the
       actual check. #}
    {% if can_edit %}
    <a href="{{ url_for('get_challenge_new', course_id=course.id) }}"
       class="btn btn-sm btn-ghost border border-base-300 font-semibold">
      New challenge
    </a>
    {% endif %}
  </div>

  <div class="flex flex-col gap-3">
    {% for challenge in course.challenges %}
    {# No `n`: the card numbers itself from `challenge.number`, which is ranked
       over the whole course. This list is filtered for a student. #}
    {% include "_challenge-card.jinja" %}
    {% else %}
    <div class="rounded-xl border border-dashed border-base-300 bg-base-200/40 px-4 py-8 text-center text-sm text-base-content/50">
      No challenges yet.
    </div>
    {% endfor %}
  </div>

  {# Every member's. The open sessions are what a student picks from; the
     closed ones stay listed, folded away, because a closed session is still
     where a student reviews what they did in it. #}
  {% set open_sessions = exercise_sessions | rejectattr("closed_at") | list %}
  {% set closed_sessions = exercise_sessions | selectattr("closed_at") | list %}
  {% if exercise_sessions %}
  <!-- ══ EXERCISE SESSIONS ═══════════════════════════════════════════ -->
  <div class="mt-10 mb-3">
    <h2 class="font-bold text-lg">Exercise sessions</h2>
    <p class="text-[13px] text-base-content/55">
      Short Python exercises, paced by your teacher. Pick the session of your group.
    </p>
  </div>

  <div class="flex flex-col gap-3">
    {% for exercise_session in open_sessions %}
    {% with course_id = course.id %}{% include "_exercise-session-card.jinja" %}{% endwith %}
    {% else %}
    <div class="rounded-xl border border-dashed border-base-300 bg-base-200/40 px-4 py-6 text-center text-sm text-base-content/50">
      No session is open right now.
    </div>
    {% endfor %}
  </div>

  {% if closed_sessions %}
  <details class="mt-3">
    <summary class="cursor-pointer text-sm text-base-content/60">
      Closed sessions ({{ closed_sessions | length }}) — still there to review
    </summary>
    <div class="flex flex-col gap-3 mt-3">
      {% for exercise_session in closed_sessions %}
      {% with course_id = course.id %}{% include "_exercise-session-card.jinja" %}{% endwith %}
      {% endfor %}
    </div>
  </details>
  {% endif %}
  {% endif %}

  {# Course staff only, and `get_course` does not even fetch the sets for
     anybody else: a set is content being authored, and the class meets it
     through a session. Every route behind this is `CourseEditor`'s. #}
  {% if can_edit %}
  <!-- ══ EXERCISES ═══════════════════════════════════════════════════ -->
  <div class="mt-10 mb-3">
    <h2 class="font-bold text-lg">Exercises</h2>
    <p class="text-[13px] text-base-content/55">
      Short Python exercises, imported from one Markdown file per set and run
      by the judge. Only staff see this list.
    </p>
  </div>

  <div class="flex flex-col gap-3">
    {% for exercise_set in exercise_sets %}
    <a href="{{ url_for('get_exercise_set', course_id=course.id, set_id=exercise_set.id) }}"
       class="card bg-base-100 border border-base-300 shadow-sm hover:border-primary/50 transition-colors">
      <div class="card-body flex-row flex-wrap items-center gap-4 px-5 py-4">
        <div class="min-w-0 flex-1">
          <div class="font-semibold">{{ exercise_set.title }}</div>
          <div class="text-xs text-base-content/55 mt-0.5">
            {% if exercise_set.current_number %}
            v{{ exercise_set.current_number }} is current ·
            {{ exercise_set.n_exercises }} exercise{{ "" if exercise_set.n_exercises == 1 else "s" }}
            {% else %}
            No version is ready yet.
            {% endif %}
          </div>
        </div>
        {% with status = exercise_set.latest_status, number = exercise_set.latest_number %}
        {% include "_exercise-version-badge.jinja" %}
        {% endwith %}
      </div>
    </a>
    {% else %}
    <div class="rounded-xl border border-dashed border-base-300 bg-base-200/40 px-4 py-8 text-center text-sm text-base-content/50">
      No exercise sets yet.
    </div>
    {% endfor %}
  </div>

  <form hx-post="{{ url_for('post_exercise_set_new', course_id=course.id) }}"
        hx-encoding="multipart/form-data"
        hx-target="#exercise-import-result"
        hx-swap="innerHTML"
        class="mt-4 rounded-xl border border-base-300 bg-base-200/40 p-4">
    <h3 class="text-xs font-bold uppercase tracking-wider text-base-content/50 mb-3">Import a set</h3>
    <div class="flex flex-wrap items-end gap-4">
      <div>
        <label class="text-xs text-base-content/55">Exercise file (.md)</label>
        <input type="file" name="exercise_file" accept=".md,text/markdown" required
               class="file-input file-input-sm w-72 mt-1" />
      </div>
      <button type="submit" class="btn btn-sm btn-primary">
        <span class="submit-label">Import</span>
        <span class="htmx-indicator loading loading-spinner loading-xs"></span>
      </button>
    </div>
    <div id="exercise-import-result" class="empty:hidden mt-3"></div>
  </form>
  {% endif %}
  {% endif %}
</main>
{% endblock %}
