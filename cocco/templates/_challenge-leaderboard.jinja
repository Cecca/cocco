{% from "_help.jinja" import help %}
{# The leaderboard card, shared by the editor and the create page.

   Context: challenge (a row, or the defaults dict), and optionally card_url
   (see _challenge-statement.jinja) plus message / ok for the footer's alert.
   With card_url the card is its own form and is swapped whole, by its id. #}

<!-- ══ LEADERBOARD ═════════════════════════════════════════════════ -->
<div id="challenge-leaderboard" class="card bg-base-100 border border-base-300 shadow-sm">
  {% if card_url %}
  <form class="card-body p-7 group" data-card{% if message and not ok %} data-dirty{% endif %}
        hx-post="{{ card_url }}"
        hx-target="#challenge-leaderboard"
        hx-swap="outerHTML">
  {% else %}
  <div class="card-body p-7">
  {% endif %}
    <h2 class="font-bold text-lg">Leaderboard {{ help("challenges", "leaderboard", "Help: Leaderboard") }}</h2>
    <p class="text-[13px] text-base-content/55 -mt-1">
      What the board on the challenge page ranks students by. Every student is
      represented by their single best submission.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Rank by</label>
        <select name="ranking" class="select w-full mt-1.5">
          <option value="running_time" {{ 'selected' if challenge.ranking == 'running_time' }}>
            Running time — fastest submission to reach the threshold
          </option>
          <option value="total_score" {{ 'selected' if challenge.ranking == 'total_score' }}>
            Total score — points summed over all tests
          </option>
        </select>
      </div>
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Score threshold</label>
        <input type="number" name="score_threshold" step="any"
               value="{{ challenge.score_threshold if challenge.score_threshold is not none }}"
               placeholder="none"
               class="input font-mono w-full mt-1.5" />
      </div>
    </div>
    <p class="text-[13px] text-base-content/55 mt-3">
      A submission's score is the sum of the raw scores its evaluator gave each
      test. Only submissions that reach the threshold appear on the leaderboard,
      on either ranking; the rest are marked failed. Ranking by time orders them
      by their summed running time, ranking by score by their score.
    </p>
    {# From the saved value, so it goes away once a threshold is saved. #}
    {% if challenge.score_threshold is none %}
    <div role="alert" class="alert alert-warning text-sm mt-3">No score threshold: every graded submission counts as passed and goes on the leaderboard, including wrong answers. On the time ranking the fastest program wins whatever it printed. With the bundled evaluators, set it to the number of test cases to require every test right.</div>
    {% endif %}
  {% if card_url %}
    {% set result_id = "leaderboard-result" %}
    {% include "_card-footer.jinja" %}
  </form>
  {% else %}
  </div>
  {% endif %}
</div>
