{% extends "base.jinja" %}
{% block title %}Editing {{ course.title }}{% endblock %}

{% set crumbs = [
  {"label": "Courses", "href": url_for('index')},
  {"label": course.title, "href": url_for('get_course', course_id=course.id)},
  {"label": "Editing"},
] %}

{% block body %}
<main class="mx-auto max-w-6xl px-6 py-8">

  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="font-serif text-3xl font-semibold tracking-tight">{{ course.title }}</h1>
    </div>
    <div class="flex items-center gap-2">
      <a href="{{ url_for('get_course_people', course_id=course.id) }}"
         class="btn btn-sm btn-ghost gap-1.5 border border-base-300 font-semibold">
        <span class="text-primary">☺</span> People
      </a>
      <a href="{{ url_for('get_course', course_id=course.id) }}"
         class="btn btn-sm btn-ghost border border-base-300 font-semibold">
        ← Back to course
      </a>
    </div>
  </div>

  <!-- ══ TITLE + DESCRIPTION ═════════════════════════════════════════ -->
  {# One form for both, the way the challenge form covers the statement and the
     limits with a single Save. The challenge list below is outside it: nested
     forms are invalid HTML, and every arrow down there is a form of its own. #}
  <form hx-post="{{ url_for('post_course_edit', course_id=course.id) }}"
        hx-target="#edit-result"
        hx-swap="innerHTML">

    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body p-7">
        <h2 class="font-bold text-lg">Title</h2>
        <p class="text-[13px] text-base-content/55 -mt-1">
          How the course is listed on the home page.
        </p>
        <input type="text" name="title" required
               value="{{ course.title }}"
               placeholder="Algorithms 101"
               class="input w-full mt-3" />
      </div>
    </div>

    {# Above the description, so the Save button below stays at the foot of the
       form it saves. #}
    <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
      <div class="card-body p-7">
        <div class="flex items-baseline justify-between">
          <h2 class="font-bold text-lg">Enrollment key</h2>
          <span class="font-mono text-xs text-base-content/45">optional</span>
        </div>
        <p class="text-[13px] text-base-content/55 -mt-1">
          Leave it empty and anyone signed in can join. Set it and students have
          to quote it on the course page before they are enrolled. It is shown
          here in the clear so you can read it out to the class.
        </p>
        <input type="text" name="enrollment_key"
               value="{{ course.enrollment_key or '' }}"
               autocomplete="off"
               placeholder="No key — anyone can join"
               class="input w-full mt-3 font-mono" />
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
      <div class="card-body p-7">
        <div class="flex items-baseline justify-between">
          <h2 class="font-bold text-lg">Description</h2>
          <span class="font-mono text-xs text-base-content/45">markdown</span>
        </div>
        <p class="text-[13px] text-base-content/55 -mt-1">
          The short introduction at the top of the course page — what the course
          is about, how it is graded, where to ask for help.
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-3">
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Source</label>
            <!-- The same preview route the challenge editor uses, so it runs
                 the same markdown filter the course page will. -->
            <textarea name="description"
                      id="description"
                      rows="16"
                      class="textarea font-mono text-sm w-full mt-1.5 leading-relaxed"
                      hx-post="{{ url_for('post_markdown_preview') }}"
                      hx-trigger="load, keyup changed delay:400ms"
                      hx-target="#preview"
                      hx-swap="innerHTML">{{ course.description }}</textarea>
          </div>
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-base-content/50">Preview</label>
            <div id="preview"
                 class="rounded-xl border border-base-300 bg-base-200/40 p-5 mt-1.5 min-h-[10rem] overflow-x-auto">
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4 mt-5">
          <button type="submit" class="btn btn-primary shadow-md shadow-primary/30">
            <span class="submit-label">Save changes</span>
            <span class="htmx-indicator loading loading-spinner loading-sm"></span>
          </button>
          {# Where the alert lands. The title in the header above is the one
             that was loaded, so it only catches up on the next page load. #}
          <div id="edit-result" class="empty:hidden flex-1"></div>
        </div>
      </div>
    </div>
  </form>

  <!-- ══ CHALLENGES ══════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-7">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="font-bold text-lg">Challenges</h2>
          <p class="text-[13px] text-base-content/55">
            The order students see them in. Moving one only changes the listing —
            no submission, score or test case is touched.
          </p>
        </div>
        <a href="{{ url_for('get_challenge_new', course_id=course.id) }}"
           class="btn btn-sm btn-ghost border border-base-300 font-semibold">
          New challenge
        </a>
      </div>

      <!-- Every move returns this whole list, so it always matches the database -->
      <div id="course-challenges" class="mt-4">
        {% with challenges = course.challenges %}
        {% include "f-course-challenges.jinja" %}
        {% endwith %}
      </div>
    </div>
  </div>

  <!-- ══ DANGER ZONE ═════════════════════════════════════════════════ -->
  {# Site administrators only. `require_course_editor` lets a plain teacher on
     to this page, so this card asks its own question - `get_course_edit`
     passes `is_admin` down. The routes behind both buttons are behind `Admin`;
     this only decides whether they are drawn. Outside the form above, like the
     challenge list: it has forms of its own. #}
  {% if is_admin %}
  <div class="card bg-base-100 border border-error/30 shadow-sm mt-6">
    <div class="card-body p-7">
      <h2 class="font-bold text-lg text-error">Danger zone</h2>
      <div id="course-danger-result" class="empty:hidden mt-3"></div>

      <div class="flex flex-wrap items-center justify-between gap-4 mt-4 rounded-xl border border-base-300 p-4">
        <div class="min-w-0 flex-1">
          <h3 class="font-semibold">
            {{ "Unarchive this course" if course.archived_at else "Archive this course" }}
          </h3>
          <p class="text-[13px] text-base-content/55">
            {% if course.archived_at %}
            It is archived: the students already on it read it but cannot
            submit, nobody else is shown it, and nobody new can join.
            Unarchiving undoes all three.
            {% else %}
            The students already on it keep reading it — statement, their
            attempts, scores, leaderboards — and stop being able to submit. It
            leaves everybody else's course list, and nobody new can join. You
            can still edit it, and you can undo this from here.
            {% endif %}
          </p>
        </div>
        {# Nothing to swap: the response is a 204 carrying HX-Redirect back to
           this page, because archiving changes the badge, every challenge card
           and this button's own label. #}
        <form hx-post="{{ url_for('post_course_unarchive' if course.archived_at else 'post_course_archive', course_id=course.id) }}"
              hx-target="#course-danger-result"
              hx-swap="innerHTML"
              hx-disabled-elt="find button">
          <button type="submit" class="btn btn-sm btn-outline btn-warning font-semibold">
            {{ "Unarchive" if course.archived_at else "Archive" }}
          </button>
        </form>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 mt-4 rounded-xl border border-error/30 p-4">
        <div class="min-w-0 flex-1">
          <h3 class="font-semibold">Delete this course</h3>
          <p class="text-[13px] text-base-content/55">
            Every challenge on it, every test case and evaluator file on disk,
            every submission and every recorded score, and every enrollment.
            There is no undo — archive it instead if you only want it out of
            the way.
          </p>
        </div>
        <button type="button" class="btn btn-sm btn-error font-semibold"
                onclick="delete_course_modal.showModal()">
          Delete course…
        </button>
      </div>
    </div>
  </div>
  {% endif %}
</main>

{% if is_admin %}
{# Deleting is irreversible, so it asks for the course's own title typed out -
   the regrade dialog in `challenge-staff.jinja` is the precedent, one turn
   stricter because a regrade can be run again and this cannot. The script
   below only *enables* the button; `post_course_delete` compares the same
   string again, because a disabled control is presentation and never the
   check. #}
<dialog id="delete_course_modal" class="modal">
  <div class="modal-box">
    <h3 class="font-bold text-lg text-error">Delete {{ course.title }}?</h3>
    <p class="py-3 text-sm text-base-content/70">
      Every challenge of this course, every test case and evaluator file, every
      submission and every score are deleted for good, and everybody on it is
      unenrolled. Nothing about this can be undone.
    </p>
    <p class="text-sm text-base-content/70">
      Type <span class="font-semibold">{{ course.title }}</span> below to confirm.
    </p>
    <input type="text" id="course-delete-confirm" name="confirm"
           autocomplete="off" data-expected="{{ course.title }}"
           aria-label="Type the course title to confirm"
           class="input w-full mt-3 font-mono" />
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-sm btn-ghost">Cancel</button>
      </form>
      <button type="button" id="course-delete-button" disabled
              class="btn btn-sm btn-error"
              hx-post="{{ url_for('post_course_delete', course_id=course.id) }}"
              hx-include="#course-delete-confirm"
              hx-target="#course-danger-result"
              hx-swap="innerHTML"
              onclick="delete_course_modal.close()">
        Delete for good
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<script>
  // The whole of the JS: enable the button only on an exact match, and clear
  // the box when the dialog closes so a cancelled attempt does not leave it
  // armed. Inline and dependency-free, like the dropzone script on the
  // challenge page - there is no build step here.
  //
  // The title travels in `data-expected`, through Jinja's attribute escaping,
  // rather than being interpolated into a JS string literal: a course called
  // "Dijkstra's" would end the string.
  (() => {
    const field = document.getElementById("course-delete-confirm");
    const button = document.getElementById("course-delete-button");
    const check = () => {
      button.disabled = field.value.trim() !== field.dataset.expected.trim();
    };
    field.addEventListener("input", check);
    document.getElementById("delete_course_modal")
            .addEventListener("close", () => { field.value = ""; check(); });
    check();
  })();
</script>
{% endif %}
{% endblock %}
