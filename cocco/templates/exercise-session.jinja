{% extends "base.jinja" %}
{% block title %}{{ session.label }}{% endblock %}

{% set crumbs = [
  {"label": "Courses", "href": url_for('index')},
  {"label": course.title, "href": url_for('get_course', course_id=course_id)},
  {"label": session.label},
] %}

{# A session as a student sees it: its exercises as far as the pacing goes.
   `session` is `student_session_view`'s, which is all this page is handed -
   the titles past `unlocked_through` never reach the template. #}
{% block body %}
<main class="mx-auto max-w-3xl px-6 py-8">
  <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">Exercise session</p>
  <h1 class="font-serif text-3xl font-semibold tracking-tight mt-1">{{ session.label }}</h1>
  <p class="text-[13px] text-base-content/55 mt-1">
    {{ session.title }}
    {% if session.closed_at %}
    · closed. You can review your work; nothing new is accepted.
    {% elif session.mode == "live" %}
    · live. Your teacher unlocks the exercises one at a time.
    {% else %}
    · open. Every exercise is unlocked.
    {% endif %}
  </p>

  <ol class="mt-6 flex flex-col gap-2">
    {% for title in session.titles %}
    <li class="rounded-xl border border-base-300 bg-base-100 px-4 py-3">
      <span class="font-mono text-sm font-semibold text-base-content/50 mr-2">{{ loop.index }}</span>{{ title }}
    </li>
    {% endfor %}
  </ol>
  {% if session.n_locked %}
  <p class="mt-3 text-sm text-base-content/55">
    {{ session.n_locked }} more exercise{{ "" if session.n_locked == 1 else "s" }} still locked — wait for your teacher.
  </p>
  {% endif %}
</main>
{% endblock %}
