{% extends "base.jinja" %}
{% block title %}{{ title }}{% endblock %}

{# An account spans every course, so it hangs off no one of them. #}
{% set crumbs = [{"label": profile.nickname}] %}

{# One URL, two pages, the way the challenge has: the owner gets forms, a site
   administrator gets the same facts as text. `can_edit` comes from
   `require_profile_reader`, never from comparing ids here — hiding a control
   in a template is presentation, and the routes behind each of these forms are
   guarded by `ProfileOwner` besides.

   Context: `profile` (`query_user_profile`'s document), `can_edit`, and the
   `message`/`ok` pair `f-profile-identity.jinja` reads. #}

{% block body %}
<main class="mx-auto max-w-4xl px-6 py-8">

  <!-- ══ WHO THIS IS ═════════════════════════════════════════════════ -->
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-8">
      <div class="flex items-start justify-between gap-4 mb-5">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
          {% if can_edit %}Your profile{% else %}Profile{% endif %}
        </p>
        <div class="flex items-center gap-2">
          {% if profile.is_admin %}
          <span class="badge badge-primary badge-sm font-mono">admin</span>
          {% endif %}
          {% if profile.is_blocked %}
          <span class="badge badge-error badge-sm font-mono">blocked</span>
          {% endif %}
        </div>
      </div>

      {# The only thing on this page that changes, so the only thing inside the
         swap target — see the fragment's own note. #}
      <div id="identity">
        {% include "f-profile-identity.jinja" %}
      </div>

      <div class="mt-7 pt-5 border-t border-base-300">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
          Email address
        </p>
        <p class="font-mono text-sm mt-1">{{ profile.email }}</p>
        <p class="text-[13px] text-base-content/45 mt-1">
          {% if can_edit %}
          This is what you sign in with, so it cannot be changed here.
          {% else %}
          The address this account signs in with.
          {% endif %}
        </p>
      </div>

      {% if profile.is_blocked %}
      <div class="mt-5 text-[13px] text-error">
        Blocked {{ profile.blocked_at | datetime }}.
        {{ profile.blocked_reason or "No reason was recorded." }}
      </div>
      {% endif %}

      <div class="mt-7 pt-5 border-t border-base-300 flex gap-10">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
            Submissions
          </p>
          <p class="font-mono text-2xl mt-1">{{ profile.n_submissions }}</p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-base-content/45">
            Last submitted
          </p>
          <p class="text-sm mt-2 text-base-content/60">
            {{ profile.last_submitted | datetime if profile.last_submitted else "—" }}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ THE COURSES ═════════════════════════════════════════════════ -->
  <div class="mt-8">
    <h2 class="font-bold text-lg">Courses</h2>
    <p class="text-[13px] text-base-content/55 mb-3">
      {% if can_edit %}
      The courses you are enrolled on, and how much you have submitted to each.
      Leaving a course is a matter for its staff.
      {% else %}
      Where this account is enrolled, and how much it has submitted to each.
      {% endif %}
    </p>

    {# Not `_course-card.jinja`: that one is a way *in* to a course, with an
       Enroll button and a description, and this is a record of where somebody
       already is. The links go to the course, which a viewer who is not on it
       will meet the enroll preview at — `get_course` decides that, not this
       list. #}
    <div class="flex flex-col gap-2">
      {% for course in profile.courses %}
      <a href="{{ url_for('get_course', course_id=course.id) }}"
         class="rounded-xl border border-base-300 bg-base-100 px-4 py-3 flex items-center gap-3 hover:border-primary transition-colors">
        <span class="badge badge-sm font-mono
                     {{ 'badge-primary' if course.role in EDITOR_ROLE_NAMES else 'badge-ghost' }}">
          {{ course.role }}
        </span>
        <span class="font-semibold flex-1">{{ course.title }}</span>
        <span class="font-mono text-sm text-base-content/55">
          {{ course.n_submissions }}
          submission{{ "" if course.n_submissions == 1 else "s" }}
        </span>
      </a>
      {% else %}
      <div class="rounded-xl border border-base-300 bg-base-100 px-4 py-6 text-center text-sm text-base-content/45">
        {% if can_edit %}
        You are not on any course yet. Pick one from the
        <a href="{{ url_for('index') }}" class="link">courses page</a>.
        {% else %}
        Not enrolled on any course.
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>

  {# ══ API TOKENS ══════════════════════════════════════════════════ #}
  {# The owner alone, which is narrower than `can_edit` — that one also admits
     a site administrator, and a list of somebody's credentials is not theirs
     to read. Every route behind these forms is guarded by `ProfileOwner`
     besides; this only decides whether the section is drawn. #}
  {% if is_owner %}
  <div class="mt-8">
    <h2 class="font-bold text-lg">API tokens</h2>
    <p class="text-[13px] text-base-content/55 mb-3">
      What the <code class="font-mono">cocco</code> command line signs in with —
      there is no browser out there to run Google sign-in in. A token acts as
      you, on everything you can reach, so keep it as you would a password and
      revoke it the moment you no longer need it.
    </p>

    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body p-7">
        <div id="tokens">
          {% include "f-tokens.jinja" %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {# ══ PASSWORD ════════════════════════════════════════════════════ #}
  {# The owner alone, for the tokens' reason one step further along: reading a
     profile is oversight, and setting somebody's password is the ability to
     become them. Behind `[auth] password_login` as well — with it off the
     routes 404, and this section would be a form for a feature that is not
     there. An administrator resets a forgotten one from `/admin`. #}
  {% if is_owner and password_login %}
  <div class="mt-8">
    <h2 class="font-bold text-lg">Password</h2>
    <p class="text-[13px] text-base-content/55 mb-3">
      The other way to sign in, beside whatever this site has configured. Only
      a hash of it is stored, so nobody — including a site administrator — can
      read it back; a forgotten one is replaced rather than recovered.
    </p>

    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body p-7">
        <div id="password">
          {% include "f-password.jinja" %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}
</main>
{% endblock %}
